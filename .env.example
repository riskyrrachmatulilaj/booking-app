# ==============================================================================
# Konfigurasi Lingkungan Booking B2B
# Salin file ini menjadi .env lalu sesuaikan nilainya.
# Jangan pernah commit file .env yang berisi rahasia atau kredensial produksi.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database PostgreSQL (Wajib untuk runtime aplikasi, migrasi, dan seed)
# ------------------------------------------------------------------------------
# Kata sandi untuk container Docker Compose (postgres:17-alpine).
POSTGRES_PASSWORD=replace-with-a-long-random-password

# URL koneksi utama PostgreSQL untuk aplikasi (Next.js server, migrasi, seed).
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://booking:replace-with-a-long-random-password@localhost:5432/booking

# URL koneksi terpisah untuk database pengujian integrasi (vitest integration).
# PENTING: Wajib menggunakan database terpisah dari DATABASE_URL untuk mencegah penghapusan data.
# Guard keamanan akan membatalkan pengujian jika mendeteksi database yang sama dengan DATABASE_URL.
TEST_DATABASE_URL=postgresql://booking:replace-with-a-long-random-password@localhost:5432/booking_test

# ------------------------------------------------------------------------------
# 2. Origin & Keamanan HTTP (Wajib)
# ------------------------------------------------------------------------------
# Origin lengkap aplikasi untuk validasi header Origin saat mutasi POST/PATCH/DELETE (CSRF protection).
# Pada lokal: http://localhost:3000
# Pada produksi: https://booking.perusahaan.com (wajib HTTPS, Secure cookie otomatis aktif)
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Kredensial Seed Administrator Awal (Wajib untuk 'npm run db:seed')
# ------------------------------------------------------------------------------
# Email untuk akun admin awal yang dibuat oleh script seed.
# Script seed menolak email duplikat dan tidak pernah mengubah role/password akun yang sudah ada.
SEED_ADMIN_EMAIL=admin@example.com

# Kata sandi akun admin awal (panjang 12-128 karakter). Tidak ada kata sandi default bawaan.
SEED_ADMIN_PASSWORD=replace-with-admin-password-123

# ------------------------------------------------------------------------------
# 4. WhatsApp Cloud API (Opsional)
# Jika tidak diisi, fitur pengingat WhatsApp beroperasi dalam mode unconfigured:
# baris pengingat tetap tersimpan dengan status 'pending', tanpa menghabiskan kuota retry.
# Jika diisi, keempat variabel di bawah ini wajib lengkap dan valid.
# ------------------------------------------------------------------------------
# Token akses Graph API Meta (disarankan System User Token berumur panjang).
WHATSAPP_ACCESS_TOKEN=

# ID nomor telepon WhatsApp Business dari Meta Developer Dashboard.
WHATSAPP_PHONE_NUMBER_ID=

# Nama template pesan WhatsApp yang telah disetujui oleh Meta (tanpa parameter dinamis).
WHATSAPP_TEMPLATE_NAME=

# Kode bahasa template WhatsApp yang disetujui (contoh: 'id' atau 'en_US').
WHATSAPP_TEMPLATE_LANGUAGE=id

# ------------------------------------------------------------------------------
# 5. Worker Pengingat Internal / Cron Secret (Wajib jika memanggil endpoint cron)
# ------------------------------------------------------------------------------
# Kunci rahasia Bearer token untuk otorisasi endpoint POST /api/internal/reminders.
# Header request: Authorization: Bearer <REMINDER_CRON_SECRET>
# Endpoint menolak panggilan jika secret ini kosong atau tidak cocok (HTTP 401/503).
REMINDER_CRON_SECRET=replace-with-a-long-random-cron-secret-token

# ------------------------------------------------------------------------------
# 6. Variabel Opsional untuk Playwright E2E Database Journey
# Hanya diperlukan jika menjalankan skenario pengujian E2E langsung terhadap PostgreSQL nyata
# yang sudah dimigrasi dan diisi data fixture pengujian.
# ------------------------------------------------------------------------------
# Aktifkan perjalanan database E2E (set ke 'true' atau '1' bila database siap)
# E2E_DATABASE_READY=
# E2E_ADMIN_EMAIL=admin@example.com
# E2E_ADMIN_PASSWORD=replace-with-admin-password-123
# E2E_STAFF_EMAIL=staf@example.com
# E2E_STAFF_PASSWORD=replace-with-staff-password-123
# E2E_COMPLETION_DATE=2030-11-01
# E2E_COMPLETION_ID=00000000-0000-0000-0000-000000000000
# E2E_SERVICE_ID=00000000-0000-0000-0000-000000000000
# E2E_STAFF_ID=00000000-0000-0000-0000-000000000000
# E2E_BOOKING_DATE=2030-11-02
